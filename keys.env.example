# ============================================================
# 你的 API Key 总表（跨设备共用一份）
# ============================================================
# 用法：
#   1. 复制本文件为 .keys.env（注意前面有个点）
#   2. 填入你自己的 Key
#   3. 运行 scripts/setup-chapter.sh <章节目录>，会自动注入到该项目的 .env
#
# ⚠️ .keys.env 已被 .gitignore 忽略，绝不会被提交到 GitHub。
#    换设备时请通过密码管理器 / 私密渠道传输，不要走 git。
# ============================================================

LLM_PROVIDER=gemini

GEMINI_API_KEY=
ANTHROPIC_API_KEY=
SILICONFLOW_API_KEY=
ARK_API_KEY=
MOONSHOT_API_KEY=
OPENROUTER_API_KEY=

# 可选：覆盖各项目的默认模型
# MODEL_NAME=
